# The app reads Supabase in development and production. Keep indexing disabled until launch checks pass.
APP_ENV=development
SITE_URL=http://localhost:3000
SITE_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# For check:supabase and test:db. Must point to an isolated local/test database.
# Hosted: direct/session pooler from the same project, with sslmode=verify-full.
# See docs/supabase-setup.md for TLS certificates and URL-encoded passwords.
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRM_ISOLATED=false

# Seed and test:seed require APP_ENV=development and both isolation confirmations.
# Use a unique local password, never commit it. Seed resets only fixture data.
TEST_SEED_PASSWORD=
TEST_SEED_CONFIRM_ISOLATED=false

# Integrasi berikutnya belum terhubung.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
AI_API_KEY=
