# preview serves explicit synthetic fixtures; supabase requires every DB setting below.
APP_MODE=preview
APP_ENV=demo
SITE_URL=http://localhost:3000
SITE_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# For check:supabase and test:db. Must point to an isolated local/test database.
# Hosted: direct/session pooler from the same project, with sslmode=verify-full.
# See docs/supabase-setup.md for TLS certificates and URL-encoded passwords.
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRM_ISOLATED=false

# Seed and test:seed require APP_ENV=test and both isolation confirmations.
# Use a unique local password, never commit it. Seed resets only fixture data.
DEMO_SEED_PASSWORD=
DEMO_SEED_CONFIRM_ISOLATED=false

# Not connected in the foundation milestone.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENTS=
AI_API_KEY=
